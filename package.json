{
  "name": "samiuls-portfolio-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#shared": "./src/shared/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "migrate:images": "tsx src/scripts/migrateProjectImagesToCloudinary.ts",
    "backfill:slugs": "tsx src/scripts/backfillProjectSlugs.ts",
    "backfill:publishing": "tsx src/scripts/backfillProjectPublishing.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.10.1",
    "multer": "2.4.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "resend": "^6.28.1",
    "sharp": "^0.33.5",
    "tsx": "^4.23.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "globals": "^15.12.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.4.1",
    "supertest": "^7.2.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@9.14.2+sha512.6e2baf77d06b9362294152c851c4f278ede37ab1eba3a55fda317a4a17b209f4dbb973fb250a77abc463a341fcb1f17f17cfa24091c4eb319cda0d9b84278387"
}
