# Copy to .env.development and fill in real values.
# On Koyeb these come from the service's environment settings instead.

# MongoDB connection string
DB_URL=

# Secret used to sign the dashboard JWT
JWT_TOKEN=

# The only address allowed to sign up or log in
ADMIN_EMAIL=

# Comma separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3002

# Cloudinary — Dashboard → Settings → API Keys.
# Optional in development, required when NODE_ENV=production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Printed by `pnpm upload:resume`
RESUME_PUBLIC_ID=

# Optional overrides
# NODE_ENV=development
# PORT=4000
# API_PREFIX=/api
# JWT_TOKEN_TTL_DAYS=7
