# Copy to .env.development and fill in real values.
# In production these come from the Vercel project's environment variables.

# MongoDB connection string
DB_URL=

# Secret used to sign the dashboard JWT
JWT_TOKEN=

# The only address allowed to sign up or log in
ADMIN_EMAIL=

# Comma separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3002

# Cloudinary — Dashboard → Settings → API Keys.
# Optional in development, required when NODE_ENV=production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Contact form delivery (Resend). Optional in development, required in
# production. Without a verified domain the only usable sender is
# onboarding@resend.dev, which is fine: it only ever mails ADMIN_EMAIL.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=onboarding@resend.dev

# The website's revalidation webhook. Optional in development (writes just skip
# the call); required in production, where the site caches project data
# indefinitely and would otherwise never update. REVALIDATE_SECRET must match
# the frontend's value.
WEB_REVALIDATE_URL=http://localhost:3002/api/revalidate
REVALIDATE_SECRET=

# Optional overrides
# NODE_ENV=development
# PORT=4000
# API_PREFIX=/api/v1
# JWT_TOKEN_TTL_DAYS=7
